#!name=Locket Gold VIP & AI
#!desc=Mở khóa Locket Gold & Tính năng AI / Quay video dài (By anhdungo)
# Author: anhdungo
# GitHub: https://github.com/dunganhngo/modules

[Script]
# ~ By anhdungo
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/dunganhngo/modules/main/Locket.js, requires-body=true, max-size=-1, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/dunganhngo/modules/main/deleteHeader.js, timeout=60

firebase = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/.*, script-path=https://raw.githubusercontent.com/dunganhngo/modules/main/firebase.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
